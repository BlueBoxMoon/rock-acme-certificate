<template>
    <Grid v-if="isAccountRegistered"
          :definition="config.gridDefinition ?? undefined"
          :data="gridDataSource"
          keyField="idKey"
          itemTerm="Certificate"
          title="Certificates"
          :entityTypeGuid="EntityType.Group"
          stickyHeader
          liveUpdates
          :showLaunchWorkflow="false"
          :onAddItem="isAccountRegistered ? onAddItem : undefined"
          @selectItem="onSelectItem">

        <TextColumn name="name"
                    title="Name"
                    field="name"
                    :filter="textValueFilter"
                    visiblePriority="xs" />

        <DateColumn name="lastRenewed"
                    title="Last Renewed"
                    field="lastRenewed"
                    :filter="dateValueFilter"
                    visiblePriority="sm" />

        <DateColumn name="expires"
                    title="Expires"
                    field="expires"
                    :filter="dateValueFilter"
                    visiblePriority="sm" />

        <TextColumn name="domains"
                    title="Domains"
                    field="domains"
                    :filter="textValueFilter"
                    width="40%"
                    visiblePriority="md" />

        <DeleteColumn v-if="isAccountRegistered" @click="onDeleteClick" />
    </Grid>
</template>

<script setup lang="ts">
    import { useConfigurationValues, useInvokeBlockAction } from "@Obsidian/Utility/block";
    import { EntityType } from "@Obsidian/SystemGuids/entityType";
    import Grid, { TextColumn, textValueFilter, DateColumn, dateValueFilter, DeleteColumn } from "@Obsidian/Controls/grid";
    import { alert } from "@Obsidian/Utility/dialogs";
    import { ListBlockBox } from "@Obsidian/ViewModels/Blocks/listBlockBox";
    import { AcmeCertificateListOptionsBag } from "./viewModels";
    import { GridDataBag } from "@Obsidian/ViewModels/Core/Grid/gridDataBag";
    import { NavigationUrlKey } from "./AcmeCertificateList/types.partial";
    import { useBrowserBus } from "@Obsidian/Utility/browserBus";
    import { ACCOUNT_CHANGED_MESSAGE, AccountChangedData } from "./AcmeCertificate/messages.partial";
    import { onBeforeUnmount, reactive, ref } from "vue";

    const config = useConfigurationValues<ListBlockBox<AcmeCertificateListOptionsBag>>();
    const invokeBlockAction = useInvokeBlockAction();
    const browserBus = useBrowserBus();

    // #region Values

    const gridDataSource = ref<Promise<GridDataBag>>();
    let gridData: GridDataBag | undefined;

    /**
     * Whether an Acme account is registered. Seeded from the block configuration
     * and updated live when the Acme Config block on the same page registers an
     * account, so the grid appears without a page refresh.
     */
    const isAccountRegistered = ref(config.options?.isAccountRegistered ?? false);

    // #endregion

    // #region Functions

    /**
     * Called when the grid is requesting the row data be loaded.
     */
    async function loadGridData(): Promise<GridDataBag> {
        const result = await invokeBlockAction<GridDataBag>("GetGridData");

        if (result.isSuccess && result.data) {
            gridData = reactive(result.data);
            return gridData;
        }
        else {
            throw new Error(result.errorMessage ?? "Unknown error while trying to load grid data.");
        }
    }

    // #endregion

    // #region Event Handlers

    /**
     * Called when a row has been selected by the individual.
     *
     * @param key The key of the row that was selected.
     */
    function onSelectItem(key: string): void {
        if (config.navigationUrls?.[NavigationUrlKey.DetailPage]) {
            window.location.href = config.navigationUrls[NavigationUrlKey.DetailPage].replace("((Key))", key);
        }
    }

    /**
     * Called when a row's delete button has been clicked by the individual. This
     * happens only if they have confirmed the delete action.
     */
    async function onDeleteClick(key: string): Promise<void> {
        const result = await invokeBlockAction<string>("Delete", {
            key
        });

        if (result.isSuccess) {
            if (gridData && gridData.rows) {
                const index = gridData.rows.findIndex(r => r["idKey"] === key);

                if (index !== -1) {
                    gridData.rows?.splice(index, 1);
                }
            }
        }
        else {
            await alert(result.errorMessage ?? "Unknown error while trying to delete certificate.");
        }
    }

    /**
     * Called when the Add button has been clicked by the individual.
     */
    function onAddItem(): void {
        if (config.navigationUrls?.[NavigationUrlKey.DetailPage]) {
            window.location.href = config.navigationUrls[NavigationUrlKey.DetailPage].replace("((Key))", "0");
        }
    }

    // #endregion

    // Reveal the grid when the account is registered elsewhere on the page.
    browserBus.subscribe<AccountChangedData>(ACCOUNT_CHANGED_MESSAGE, (message) => {
        if (message.data?.isRegistered && !isAccountRegistered.value) {
            isAccountRegistered.value = true;
            gridDataSource.value = loadGridData();
        }
    });

    onBeforeUnmount(() => browserBus.dispose());

    gridDataSource.value = loadGridData();
</script>
